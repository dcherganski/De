# Copy to .env and fill in. Never commit .env. No value below is a real secret.

# --- database (compose) -------------------------------------------------------------
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# --- mode: PAPER is the default. LIVE is refused in this build regardless. ------------
MODE=paper
ALLOW_LIVE_TRADING=false

# --- market data ----------------------------------------------------------------------
# bybit (main) | kraken (fallback) | fixture (labelled test replay, needs FIXTURE_PATH)
QUOTE_VENUE=bybit
# eu = Bybit EU (api.bybit.eu, EEA accounts) | global = api.bybit.com
BYBIT_REGION=eu
SYMBOL=BTC/EUR

# --- TypeSafe Jev (without a key the engine runs, but makes no signals) -----------------
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# --- news: rss (free feeds) | none ------------------------------------------------------
NEWS_PROVIDER=rss

# --- secrets: generate with `docker compose run --rm api python -m app.cli gen-keys` -----
# Fernet key that encrypts exchange API keys at rest. Losing it makes stored keys unreadable.
SECRETS_MASTER_KEY=
# Bearer token for the optional read-only MCP server (profile "mcp"), at least 32 characters.
MCP_TOKEN=
# Set to true when the dashboard is served over HTTPS.
COOKIE_SECURE=false

# --- simulation assumptions (experimental, not proven profitable) -----------------------
PAPER_FEE_RATE=0.0025
PAPER_SLIPPAGE_BPS=5
INITIAL_BTC_VALUE_EUR=200
INITIAL_CASH_EUR=0

# --- risk limits ----------------------------------------------------------------------
MAX_ORDER_EUR=100
MAX_EXPOSURE_EUR=400
DAILY_LOSS_LIMIT_EUR=10
MAX_TRADES_PER_DAY=6
MIN_SECONDS_BETWEEN_TRADES=900
MAX_SPREAD_PCT=0.15
MAX_QUOTE_AGE_S=15

# --- fixed monthly costs shown separately on the dashboard (EUR) -------------------------
INFRA_COST_EUR_PER_MONTH=0
NEWS_COST_EUR_PER_MONTH=0
